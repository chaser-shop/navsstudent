# Рядок підключення до MongoDB Atlas (обов'язково).
MONGODB_URI=mongodb+srv://користувач:пароль@кластер.mongodb.net/?retryWrites=true&w=majority

# ПІБ адміністраторів через кому (повністю, як вводять під час реєстрації).
ADMIN_NAMES=Прізвище Ім'я По батькові

# Секрет для першої реєстрації під ПІБ адміністратора (довгий випадковий рядок).
# Без нього ПІБ адміністратора може зареєструвати будь-хто, хто зробить це першим.
ADMIN_PASSWORD=замініть-на-довгий-випадковий-рядок

# ОБОВ'ЯЗКОВО реальна пошта: з фіктивною (example.com) Apple відповідає 403 і сповіщення не приходять.
VAPID_SUBJECT=mailto:ваша-пошта@gmail.com

# Google-таблиця рейтингу. Якщо доступ «Усі, хто має посилання — читач», ключі не потрібні.
GOOGLE_SHEET_ID=1grET3-MHCkBXqrBrHL1BIiUnAks0Kh3P4MuOijcPykY
GOOGLE_SHEET_GID=0
GOOGLE_SHEET_GROUP=101 СПД
GOOGLE_SHEET_INTERVAL_MS=300000
# Необов'язково: адреса опублікованого CSV (Файл → Поділитися → Опублікувати в інтернеті → CSV).
# GOOGLE_SHEET_CSV_URL=
# Необов'язково, лише для закритої таблиці: JSON-ключ сервісного акаунта (в один рядок).
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Бали: найбільший бал, до якого студент може підвищити свій бал з предмета.
SCORE_MAX=100
# Година щоденного сповіщення про прогрес (за APP_TZ).
PROGRESS_HOUR=19

# Необов'язково
DB_NAME=navsstudents
APP_TZ=Europe/Kyiv
# MAX_DEVICES=5
# REQUIRE_DEVICE_APPROVAL=false
# JWT_SECRET, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY — якщо не вказати, сервер згенерує й збереже їх у MongoDB.
