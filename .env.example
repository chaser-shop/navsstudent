
MONGODB_URI=mongodb+srv://КОРИСТУВАЧ:ПАРОЛЬ@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# ПІБ адміністраторів через кому (повністю, як вводять при вході).
# Якщо не вказати — адміністратором стане перша людина, що увійде.
ADMIN_NAMES=Савицький Денис Дмитрович

# Необов'язково: пароль, за яким адмін може увійти з НОВОГО пристрою
# (решта користувачів надсилає запит на новий пристрій — адмін підтверджує його в «Учасники й пристрої»).
ADMIN_PASSWORD=придумайте_свій_пароль

# Необов'язково
DB_NAME=navsstudents
APP_TZ=Europe/Kyiv
# ОБОВ'ЯЗКОВО реальна пошта: з фіктивною (example.com) Apple відповідає 403 і сповіщення не приходять.
VAPID_SUBJECT=mailto:ваша.справжня@gmail.com

# Скільки пристроїв може мати одна людина (за замовчуванням 5)
# MAX_DEVICES=5
# JWT_SECRET, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY — якщо не вказати, сервер згенерує й збереже в MongoDB сам.
