# Обов'язково: рядок підключення до MongoDB (наприклад, з MongoDB Atlas)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# ПІБ адміністраторів через кому (повністю, як вводять при вході).
# Якщо не вказати — адміністратором стане перша людина, що увійде.
ADMIN_NAMES=Іваненко Іван Іванович

# Необов'язково: пароль, за яким адмін може увійти з НОВОГО пристрою
# (звичайних користувачів вхід із нового пристрою блокується, їх відв'язує адмін).
ADMIN_PASSWORD=

# Необов'язково
DB_NAME=diary
APP_TZ=Europe/Kyiv
VAPID_SUBJECT=mailto:you@example.com
# JWT_SECRET, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY — якщо не вказати, сервер згенерує й збереже в MongoDB сам.
